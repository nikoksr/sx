#!/usr/bin/env bash

set -euo pipefail

((BASH_VERSINFO[0] < 4)) && {
  echo "Error: sx requires Bash 4+. You have Bash $BASH_VERSION." >&2
  exit 1
}

# ── Configuration ────────────────────────────────────────────────

SEARCH_PATH="${PWD}"
INITIAL_QUERY=""
INITIAL_MODE="fd"
HAS_RGA=0
SX_OPEN_CMD=""
HAS_CLIPBOARD=0

SX_THREADS=$(($(nproc 2> /dev/null || echo 4) - 1))
[[ $SX_THREADS -lt 1 ]] && SX_THREADS=1

SX_MIN_QUERY=3

SX_VERSION="0.4.0"

# Directories to always exclude from search
SX_EXCLUDES="\
.git .hg .svn \
node_modules vendor Pods .pnpm-store bower_components \
target build dist out .nuxt .next .output \
__pycache__ .venv venv env .tox .mypy_cache .pytest_cache .eggs .conda .pixi \
.zvm .pyenv .nvm .sdkman .rbenv .cargo .rustup .luarocks \
.npm .yarn .cache .gradle .maven .ivy2 .nuget .pub-cache .dart_tool .fvm \
.idea .vscode .vs .fleet \
"

SX_TEXT_EXTS="py pyw rs go js ts jsx tsx java c h cpp hpp cs rb php pl pm swift kt kts \
scala clj cljs hs ml mli ex exs erl dart lua r tcl m \
sh bash zsh fish ps1 bat cmd \
conf cfg ini toml yaml yml json jsonc envrc \
md mdx rst txt adoc org tex \
css scss sass less html htm svg vue svelte astro \
csv tsv xml sql graphql proto lock \
dockerfile makefile cmake gemfile rakefile cargo \
gitignore gitattributes editorconfig license readme"

# ── Help ─────────────────────────────────────────────────────────

show_help() {
  cat << 'EOF'
sx - Universal Search Tool

Usage: sx [options] [path]
       sx doctor

Options:
  -q, --query QUERY    Start with initial search query
  -m, --mode MODE      Start in mode: file (default), rg, rga
  -v, --version        Show version
  -h, --help           Show this help
  doctor               Run diagnostic health check

Modes (toggle with CTRL-T):
  [fd]  File search    — fuzzy filter over fd results
  [rg]  Content search — ripgrep on every keystroke
  [rga] Universal      — ripgrep-all (PDFs, docx, archives, etc.)

Key Bindings:
  CTRL-T     Cycle mode: fd → rg → rga → fd
  CTRL-H     Toggle hidden files
  CTRL-G     Toggle .gitignore respect
  CTRL-W     Toggle preview line wrap
  Enter      Smart open (text → $EDITOR, other → system open)
  ALT-Enter  Force system open
  CTRL-Y     Copy file path to clipboard
EOF
}

# ── Dependency Checking ──────────────────────────────────────────

# Resolve a command from a list of candidate names (e.g., fd/fdfind on Debian).
# Prints the first name found; returns 1 if none are found.
resolve_cmd() {
  local cmd
  for cmd in "$@"; do
    command -v "$cmd" > /dev/null 2>&1 && {
      echo "$cmd"
      return 0
    }
  done
  return 1
}

check_deps() {
  local missing=()

  SX_FD=$(resolve_cmd fd fdfind) || missing+=("fd (on Debian/Ubuntu: apt install fd-find)")
  SX_BAT=$(resolve_cmd bat batcat) || missing+=("bat (on Debian/Ubuntu: apt install bat)")

  command -v rg > /dev/null 2>&1 || missing+=("rg")
  command -v fzf > /dev/null 2>&1 || missing+=("fzf")

  if [[ ${#missing[@]} -gt 0 ]]; then
    echo "Error: missing required commands: ${missing[*]}"
    echo "Please install them before running sx."
    exit 1
  fi

  command -v rga > /dev/null 2>&1 && HAS_RGA=1
  if command -v xdg-open > /dev/null 2>&1; then
    SX_OPEN_CMD="xdg-open"
  elif command -v open > /dev/null 2>&1; then
    SX_OPEN_CMD="open"
  elif command -v wslview > /dev/null 2>&1; then
    SX_OPEN_CMD="wslview"
  fi

  if command -v wl-copy > /dev/null 2>&1; then
    HAS_CLIPBOARD=1
  elif command -v xclip > /dev/null 2>&1; then
    HAS_CLIPBOARD=1
  elif command -v pbcopy > /dev/null 2>&1; then
    HAS_CLIPBOARD=1
  fi

  if [[ "$HAS_CLIPBOARD" -eq 0 ]]; then
    echo "Warning: no clipboard tool found (wl-copy/xclip/pbcopy). CTRL-Y will not work." >&2
  fi

  # fzf version check (--with-shell: requires >= 0.52)
  local fzf_version
  read -r fzf_version _ <<< "$(fzf --version 2> /dev/null || echo "0.0")"
  local fzf_major fzf_minor
  IFS='.' read -r fzf_major fzf_minor _ <<< "$fzf_version"
  if ((fzf_major == 0 && fzf_minor < 52)); then
    echo "Error: sx requires fzf >= 0.52. You have $(fzf --version 2> /dev/null | head -1)." >&2
    exit 1
  fi

  if [[ -z "$SX_OPEN_CMD" ]]; then
    echo "Warning: no open command found (xdg-open/open/wslview). Opening non-text files will not work." >&2
  fi
}

# ── Argument Parsing ─────────────────────────────────────────────

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -q | --query)
        if [[ $# -lt 2 ]]; then
          echo "Error: --query requires a value" >&2
          exit 1
        fi
        INITIAL_QUERY="$2"
        shift 2
        ;;
      -m | --mode)
        if [[ $# -lt 2 ]]; then
          echo "Error: --mode requires a value" >&2
          exit 1
        fi
        case "$2" in
          file | fd) INITIAL_MODE="fd" ;;
          rg) INITIAL_MODE="rg" ;;
          rga) INITIAL_MODE="rga" ;;
          *)
            echo "Error: unknown mode '$2'. Use: file, rg, rga"
            exit 1
            ;;
        esac
        shift 2
        ;;
      -v | --version)
        echo "sx $SX_VERSION"
        exit 0
        ;;
      -h | --help)
        show_help
        exit 0
        ;;
      -*)
        echo "Error: unknown option '$1'"
        show_help
        exit 1
        ;;
      *)
        if [[ -d "$1" ]]; then
          if [[ "$SEARCH_PATH" != "${PWD}" ]]; then
            echo "Error: only one search path is allowed (already have '$SEARCH_PATH')" >&2
            exit 1
          fi
          SEARCH_PATH="$1"
        else
          echo "Error: '$1' is not a directory" >&2
          exit 1
        fi
        shift
        ;;
    esac
  done
}

# ── State Setup ──────────────────────────────────────────────────

setup_state() {
  SX_STATE_DIR=$(mktemp -d)
  trap 'rm -rf "$SX_STATE_DIR"' EXIT

  echo "off" > "$SX_STATE_DIR/hidden"
  echo "on" > "$SX_STATE_DIR/gitignore"
  echo "$INITIAL_MODE" > "$SX_STATE_DIR/mode"

  export SX_STATE_DIR
}

# ── Text File Detection ─────────────────────────────────────────

is_text_file() {
  local f="$1"
  local ext="${f##*.}"
  ext="${ext,,}"

  local base
  base="${f##*/}"
  base="${base,,}"

  if [[ " $SX_TEXT_EXTS " == *" $ext "* ]] || [[ " $SX_TEXT_EXTS " == *" $base "* ]]; then
    return 0
  fi

  case "$base" in
    vagrantfile | jenkinsfile | brewfile | \
      authors | changelog | copying | install | news | todo | \
      .gitignore | .gitattributes | .editorconfig | .envrc | .bashrc | .zshrc | .profile | .bash_profile)
      return 0
      ;;
  esac

  local mime
  mime=$(file --mime-type -b "$f" 2> /dev/null || echo "")
  [[ "$mime" == text/* ]]
}

# ── Smart Open Dispatcher ───────────────────────────────────────

sx_open() {
  local file="$1"
  local line="${2:-}"
  local force_xdg="${3:-}"

  if [[ -n "$force_xdg" ]]; then
    nohup "$SX_OPEN_CMD" "$file" > /dev/null 2>&1 &
    disown
    return 0
  fi

  if is_text_file "$file"; then
    local editor_cmd
    editor_cmd="$(command -v "${EDITOR:-vim}" 2> /dev/null || echo vim)"
    local editor_name
    editor_name="${editor_cmd##*/}"

    if [[ "$editor_name" =~ code|cursor|windsurf ]]; then
      if [[ -n "$line" ]]; then
        exec "$editor_cmd" --goto "${file}:${line}"
      else
        exec "$editor_cmd" "$file"
      fi
    else
      if [[ -n "$line" ]]; then
        exec "$editor_cmd" "+${line}" "$file"
      else
        exec "$editor_cmd" "$file"
      fi
    fi
  else
    nohup "$SX_OPEN_CMD" "$file" > /dev/null 2>&1 &
    disown
  fi
}

# ── Clipboard & Force-Open Helpers ────────────────────────────────

sx_clip() {
  local filepath="$1"
  if command -v wl-copy > /dev/null 2>&1; then
    printf '%s' "$filepath" | wl-copy
  elif command -v xclip > /dev/null 2>&1; then
    printf '%s' "$filepath" | xclip -selection clipboard
  elif command -v pbcopy > /dev/null 2>&1; then
    printf '%s' "$filepath" | pbcopy
  fi
}

sx_force_open() {
  local filepath="$1"
  nohup "$SX_OPEN_CMD" "$filepath" > /dev/null 2>&1 &
  disown
}

# ── Preview Dispatcher ──────────────────────────────────────────

sx_preview() {
  local entry="$1"
  local query="${2:-}"
  local mode
  read -r mode < "$SX_STATE_DIR/mode" 2> /dev/null || mode="fd"

  if [[ "$mode" == "fd" ]]; then
    # File mode: show the full file (up to 300 lines)
    "$SX_BAT" --color=always --style=full --line-range :300 "$entry" 2> /dev/null \
      || echo "Preview not available"
  else
    # Content mode: show file content centered on the matched line
    local file line
    IFS=':' read -r file line _ <<< "$entry"

    if is_text_file "$file"; then
      # Show around 20 lines around the match, with the matched line highlighted
      local start=$((line - 20))
      [[ $start -lt 1 ]] && start=1

      "$SX_BAT" --color=always --style=full \
        --highlight-line "$line" \
        --line-range "${start}:$((line + 20))" \
        "$file" 2> /dev/null || echo "Preview not available"
    elif [[ "$mode" == "rga" ]] && [[ -n "$query" ]]; then
      # rga mode with binary files: try extracting text
      rga --pretty --context 5 "$query" "$file" 2> /dev/null | head -100 \
        || echo "Binary file - cannot preview"
    else
      echo "Binary file: ${file##*/}"
    fi
  fi
}

# ── Enter Handler ───────────────────────────────────────────────

sx_enter() {
  local entry="$1"
  local mode
  read -r mode < "$SX_STATE_DIR/mode" 2> /dev/null || mode="fd"

  local state_dir="$SX_STATE_DIR"

  if [[ "$mode" == "fd" ]]; then
    rm -rf "$state_dir" 2> /dev/null
    sx_open "$entry" ""
  else
    local file line
    IFS=':' read -r file line _ <<< "$entry"
    rm -rf "$state_dir" 2> /dev/null
    sx_open "$file" "$line"
  fi
}
# ── Header Builder ──────────────────────────────────────────────

build_header() {
  local mode hidden gitignore
  read -r mode < "$SX_STATE_DIR/mode" 2> /dev/null || mode="fd"
  read -r hidden < "$SX_STATE_DIR/hidden" 2> /dev/null || hidden="off"
  read -r gitignore < "$SX_STATE_DIR/gitignore" 2> /dev/null || gitignore="on"

  local mode_label
  case "$mode" in
    fd) mode_label="[fd] Files" ;;
    rg) mode_label="[rg] Content" ;;
    rga) mode_label="[rga] Universal" ;;
  esac

  local gitignore_label="respected"
  [[ "$gitignore" == "off" ]] && gitignore_label="ignored"

  printf \
    'CTRL-T: mode │ CTRL-H: hidden │ CTRL-G: gitignore │ CTRL-W: wrap │ CTRL-Y: copy │  Mode: %s │ Hidden: %s │ Gitignore: %s' \
    "$mode_label" "$hidden" "$gitignore_label"
}

# ── RG/RGA Wrappers (empty query guard) ──────────────────────────

_sx_rg() {
  local query="$1"
  shift
  if ((${#query} < ${SX_MIN_QUERY:-3})); then
    exit 0
  fi
  rg "$@" -- "$query" "$SEARCH_PATH"
}

_sx_rga() {
  local query="$1"
  shift
  if ((${#query} < ${SX_MIN_QUERY:-3})); then
    exit 0
  fi
  rga "$@" -- "$query" "$SEARCH_PATH"
}

# ── Backend Command Builders ────────────────────────────────────

build_fd_cmd() {
  local hidden gitignore
  read -r hidden < "$SX_STATE_DIR/hidden" 2> /dev/null || hidden="off"
  read -r gitignore < "$SX_STATE_DIR/gitignore" 2> /dev/null || gitignore="on"

  local cmd="$SX_FD --type f --color=always"

  local excl
  for excl in $SX_EXCLUDES; do
    cmd+=" --exclude $excl"
  done

  [[ "$hidden" == "on" ]] && cmd+=" --hidden"
  [[ "$gitignore" == "off" ]] && cmd+=" --no-ignore"

  cmd+=" . $(printf '%q' "$SEARCH_PATH")"

  echo "$cmd"
}

build_search_cmd() {
  local searcher="$1"
  local hidden gitignore
  read -r hidden < "$SX_STATE_DIR/hidden" 2> /dev/null || hidden="off"
  read -r gitignore < "$SX_STATE_DIR/gitignore" 2> /dev/null || gitignore="on"

  local cmd="${searcher} {q} --column --line-number --no-heading --color=always --smart-case --max-count 100 --threads $SX_THREADS"

  [[ "$hidden" == "on" ]] && cmd+=" --hidden"
  [[ "$gitignore" == "off" ]] && cmd+=" --no-ignore"

  local excl
  for excl in $SX_EXCLUDES; do
    cmd+=" --glob '!$excl'"
  done

  cmd+=" || true"

  echo "$cmd"
}

build_rg_cmd() { build_search_cmd "_sx_rg"; }
build_rga_cmd() { build_search_cmd "_sx_rga"; }

# ── Shared: Reload current mode (used by toggle transforms) ──────

_sx_reload_current_mode() {
  local mode header cmd
  read -r mode < "$SX_STATE_DIR/mode" 2> /dev/null || mode="fd"

  case "$mode" in
    fd) cmd=$(build_fd_cmd) ;;
    rg) cmd=$(build_rg_cmd) ;;
    rga) cmd=$(build_rga_cmd) ;;
  esac

  header=$(build_header)
  if [[ "$mode" == "fd" ]]; then
    echo "change-header(${header})+reload(${cmd})"
  else
    echo "change-header(${header})+reload(sleep 0.1; ${cmd})"
  fi
}

# ── Transform: Mode Toggle (CTRL-T) ────────────────────────────

sx_transform_mode() {
  local mode header
  read -r mode < "$SX_STATE_DIR/mode" 2> /dev/null || mode="fd"
  if [[ "$mode" == "fd" ]]; then
    echo "rg" > "$SX_STATE_DIR/mode"
    local cmd
    cmd=$(build_rg_cmd)
    header=$(build_header)
    echo "change-prompt([rg] ❯ )+disable-search+change-preview-window(down,60%,border-top,wrap)+change-header(${header})+reload(sleep 0.1; ${cmd})"
  elif [[ "$mode" == "rg" ]]; then
    if [[ "$HAS_RGA" -eq 1 ]]; then
      echo "rga" > "$SX_STATE_DIR/mode"
      local cmd
      cmd=$(build_rga_cmd)
      header=$(build_header)
      echo "change-prompt([rga] ❯ )+change-header(${header})+reload(sleep 0.1; ${cmd})"
    else
      echo "fd" > "$SX_STATE_DIR/mode"
      local cmd
      cmd=$(build_fd_cmd)
      header=$(build_header)
      echo "change-prompt([fd] ❯ )+enable-search+change-preview-window(down,60%,border-top,wrap)+change-header(${header})+reload(${cmd})"
    fi
  else
    echo "fd" > "$SX_STATE_DIR/mode"
    local cmd
    cmd=$(build_fd_cmd)
    header=$(build_header)
    echo "change-prompt([fd] ❯ )+enable-search+change-preview-window(down,60%,border-top,wrap)+change-header(${header})+reload(${cmd})"
  fi
}

# ── Transform: Hidden Toggle (CTRL-H) ──────────────────────────

sx_transform_hidden() {
  local current
  read -r current < "$SX_STATE_DIR/hidden" 2> /dev/null || current="off"
  [[ "$current" == "off" ]] && echo "on" > "$SX_STATE_DIR/hidden" || echo "off" > "$SX_STATE_DIR/hidden"
  _sx_reload_current_mode
}

# ── Transform: Gitignore Toggle (CTRL-G) ───────────────────────

sx_transform_gitignore() {
  local current
  read -r current < "$SX_STATE_DIR/gitignore" 2> /dev/null || current="on"
  [[ "$current" == "on" ]] && echo "off" > "$SX_STATE_DIR/gitignore" || echo "on" > "$SX_STATE_DIR/gitignore"
  _sx_reload_current_mode
}

# ── Transform: Change (for rg/rga mode keystroke reload) ──────────────

sx_transform_change() {
  local mode
  read -r mode < "$SX_STATE_DIR/mode" 2> /dev/null || mode="fd"

  if [[ "$mode" == "rg" ]]; then
    local cmd
    cmd=$(build_rg_cmd)
    echo "reload(sleep 0.1; ${cmd})"
  elif [[ "$mode" == "rga" ]]; then
    local cmd
    cmd=$(build_rga_cmd)
    echo "reload(sleep 0.1; ${cmd})"
  fi
}

# ── Export Functions ─────────────────────────────────────────────

export_fns() {
  export SX_STATE_DIR SX_EXCLUDES SX_TEXT_EXTS SEARCH_PATH HAS_RGA SX_OPEN_CMD HAS_CLIPBOARD SX_THREADS SX_MIN_QUERY SX_FD SX_BAT
  export -f is_text_file sx_open sx_preview sx_enter sx_clip sx_force_open
  export -f _sx_rg _sx_rga
  export -f build_header build_fd_cmd build_search_cmd build_rg_cmd build_rga_cmd
  export -f _sx_reload_current_mode sx_transform_mode sx_transform_hidden
  export -f sx_transform_gitignore sx_transform_change
}

# ── Doctor (Diagnostic Health Check) ─────────────────────────────

_doctor_extract_version() {
  local cmd="$1"
  local line
  line=$("$cmd" --version 2> /dev/null | head -1) || return 1
  [[ -z "$line" ]] && return 1
  if [[ $line =~ [0-9]+\.[0-9]+\.[0-9]+[^[:space:]]* ]]; then
    printf '%s\n' "${BASH_REMATCH[0]}"
    return 0
  fi
  return 1
}

_doctor_status() {
  local type="$1" label="$2" value="${3:-}" hint="${4:-}"
  local symbol="" color=""
  case "$type" in
    ok)
      symbol="✓"
      color="${_SX_DOK:-}"
      ;;
    fail)
      symbol="✗"
      color="${_SX_DERR:-}"
      ;;
    warn)
      symbol="⚠"
      color="${_SX_DWARN:-}"
      ;;
  esac
  if [[ -n "$value" && -n "$hint" ]]; then
    printf '  %s%s%s %-12s %-10s %s\n' \
      "$color" "$symbol" "${_SX_DRESET:-}" "$label" "$value" "$hint"
  elif [[ -n "$value" ]]; then
    printf '  %s%s%s %-12s %s\n' \
      "$color" "$symbol" "${_SX_DRESET:-}" "$label" "$value"
  elif [[ -n "$hint" ]]; then
    printf '  %s%s%s %s %s\n' \
      "$color" "$symbol" "${_SX_DRESET:-}" "$label" "$hint"
  else
    printf '  %s%s%s %s\n' \
      "$color" "$symbol" "${_SX_DRESET:-}" "$label"
  fi
}

_doctor_section() {
  printf '\n%s\n' "$1"
}

sx_doctor() {
  local errors=0 warnings=0
  local fzf_ver=""
  local resolved version pretty_name line bash_ver terminal ssh_status
  local kernel_name kernel arch fzf_major fzf_minor
  local clip_cmd open_cmd nproc_cmd file_cmd err_word warn_word tput_colors

  # Colors (only when stdout is a terminal)
  if [[ -t 1 ]]; then
    _SX_DOK=$'\e[32m'
    _SX_DERR=$'\e[31m'
    _SX_DWARN=$'\e[33m'
    _SX_DRESET=$'\e[0m'
  else
    _SX_DOK=""
    _SX_DERR=""
    _SX_DWARN=""
    _SX_DRESET=""
  fi

  printf 'sx %s — diagnosis report\n' "$SX_VERSION"

  # ── Platform ──

  _doctor_section "Platform"

  pretty_name=""
  if [[ -f /etc/os-release ]]; then
    line=$(grep -m1 '^PRETTY_NAME=' /etc/os-release 2> /dev/null) || true
    if [[ -n "$line" ]]; then
      pretty_name="${line#PRETTY_NAME=}"
      pretty_name="${pretty_name//\"/}"
    fi
  fi
  [[ -z "$pretty_name" ]] && pretty_name=$(uname -s 2> /dev/null || echo "unknown")

  kernel_name=$(uname -s 2> /dev/null | tr '[:upper:]' '[:lower:]' || echo "unknown")
  kernel=$(uname -r 2> /dev/null || echo "unknown")
  arch=$(uname -m 2> /dev/null || echo "unknown")

  printf '  %-13s%s (%s %s)  [%s]\n' "OS:" "$pretty_name" "$kernel_name" "$kernel" "$arch"

  bash_ver="${BASH_VERSION%% *}"
  printf '  %-13s%s\n' "Bash:" "$bash_ver"

  terminal="${TERM:-unknown}"
  [[ -n "${TERM_PROGRAM:-}" ]] && terminal="$terminal ($TERM_PROGRAM)"
  printf '  %-13s%s\n' "Terminal:" "$terminal"

  if [[ -n "${SSH_CONNECTION:-}" || -n "${SSH_TTY:-}" ]]; then
    ssh_status="yes"
  else
    ssh_status="no"
  fi
  printf '  %-13s%s\n' "SSH:" "$ssh_status"

  tput_colors=$(tput colors 2> /dev/null) || true
  [[ -n "$tput_colors" ]] && printf '  %-13s%s\n' "Colors:" "$tput_colors"

  # ── Dependencies ──

  _doctor_section "Dependencies"

  resolved=$(resolve_cmd fd fdfind 2> /dev/null) || true
  if [[ -n "$resolved" ]]; then
    version=$(_doctor_extract_version "$resolved") || version=""
    _doctor_status ok "fd" "$version" "($resolved)"
  else
    _doctor_status fail "fd" "not found" "← required"
    errors=$((errors + 1))
  fi

  resolved=$(resolve_cmd bat batcat 2> /dev/null) || true
  if [[ -n "$resolved" ]]; then
    version=$(_doctor_extract_version "$resolved") || version=""
    _doctor_status ok "bat" "$version" "($resolved)"
  else
    _doctor_status fail "bat" "not found" "← required"
    errors=$((errors + 1))
  fi

  if command -v rg > /dev/null 2>&1; then
    version=$(_doctor_extract_version rg) || version=""
    _doctor_status ok "rg" "$version"
  else
    _doctor_status fail "rg" "not found" "← required"
    errors=$((errors + 1))
  fi

  if command -v fzf > /dev/null 2>&1; then
    fzf_ver=$(_doctor_extract_version fzf) || fzf_ver=""
    _doctor_status ok "fzf" "$fzf_ver"
  else
    _doctor_status fail "fzf" "not found" "← required"
    errors=$((errors + 1))
  fi

  # ── Optional ──

  _doctor_section "Optional"

  if command -v rga > /dev/null 2>&1; then
    version=$(_doctor_extract_version rga) || version=""
    _doctor_status ok "rga" "$version"
  else
    _doctor_status fail "rga" "not found" "← rga mode unavailable"
  fi

  clip_cmd=$(resolve_cmd wl-copy xclip pbcopy 2> /dev/null) || true
  if [[ -n "$clip_cmd" ]]; then
    _doctor_status ok "clipboard" "$clip_cmd"
  else
    _doctor_status fail "clipboard" "not found" "← Ctrl-Y will not work"
    warnings=$((warnings + 1))
  fi

  open_cmd=$(resolve_cmd xdg-open open wslview 2> /dev/null) || true
  if [[ -n "$open_cmd" ]]; then
    _doctor_status ok "open" "$open_cmd"
  else
    _doctor_status fail "open" "not found" "← opening non-text files will not work"
    warnings=$((warnings + 1))
  fi

  if [[ -n "${EDITOR:-}" ]]; then
    _doctor_status ok "editor" "${EDITOR##*/}" '(from $EDITOR)'
  else
    _doctor_status warn "editor" "not set" "← will default to vim"
  fi

  # ── Diagnostics ──

  _doctor_section "Diagnostics"

  if [[ -n "$fzf_ver" ]]; then
    IFS='.' read -r fzf_major fzf_minor _ <<< "$fzf_ver"
    if [[ "$fzf_major" =~ ^[0-9]+$ ]] && ((fzf_major == 0 && fzf_minor < 52)); then
      _doctor_status fail "fzf >= 0.52" "$fzf_ver" "← sx requires fzf >= 0.52"
      errors=$((errors + 1))
    else
      _doctor_status ok "fzf >= 0.52" "" "required version"
    fi

    if [[ "$fzf_ver" == "0.66.0" ]]; then
      _doctor_status warn "Ctrl+H binding" "" \
        "likely broken — fzf 0.66.0 has a known bug (junegunn/fzf#4556)"
      warnings=$((warnings + 1))
    fi
  else
    _doctor_status fail "fzf >= 0.52" "" "← fzf not installed"
    errors=$((errors + 1))
  fi

  nproc_cmd=$(command -v nproc 2> /dev/null) || true
  if [[ -n "$nproc_cmd" ]]; then
    _doctor_status ok "nproc" "" "available"
  else
    _doctor_status warn "nproc" "" "← thread count will default to 4"
    warnings=$((warnings + 1))
  fi

  file_cmd=$(command -v file 2> /dev/null) || true
  if [[ -n "$file_cmd" ]]; then
    _doctor_status ok "file" "" "available"
  else
    _doctor_status warn "file" "" "← MIME type detection will be limited"
    warnings=$((warnings + 1))
  fi

  # ── Summary ──

  if [[ $errors -eq 0 && $warnings -eq 0 ]]; then
    printf '\nAll checks passed.\n'
  else
    err_word="errors"
    warn_word="warnings"
    [[ $errors -eq 1 ]] && err_word="error"
    [[ $warnings -eq 1 ]] && warn_word="warning"
    printf '\n%d %s, %d %s found.\n' "$errors" "$err_word" "$warnings" "$warn_word"
  fi

  [[ $errors -gt 0 ]] && return 1
  return 0
}

# ── Main ─────────────────────────────────────────────────────────

main() {
  if [[ "${1:-}" == "doctor" ]]; then
    sx_doctor
    exit $?
  fi

  parse_args "$@"
  check_deps

  if [[ "$INITIAL_MODE" == "rga" && "$HAS_RGA" -eq 0 ]]; then
    echo "Warning: rga not found, falling back to rg mode" >&2
    INITIAL_MODE="rg"
  fi

  setup_state
  export_fns

  local initial_cmd
  case "$INITIAL_MODE" in
    fd) initial_cmd=$(build_fd_cmd) ;;
    rg) initial_cmd=$(build_rg_cmd) ;;
    rga) initial_cmd=$(build_rga_cmd) ;;
  esac

  local fzf_args=(
    --ansi
    --prompt "[${INITIAL_MODE}] ❯ "
    --layout=reverse
    --border=rounded
    --info=inline
    --delimiter :
    --no-multi
    --with-shell 'bash -c'
    --header "$(build_header)"
    --preview 'sx_preview {} {q}'
    --bind "start:reload(${initial_cmd})"
    --bind "ctrl-t:transform:sx_transform_mode"
    --bind "ctrl-h:transform:sx_transform_hidden"
    --bind "ctrl-g:transform:sx_transform_gitignore"
    --bind "change:transform:sx_transform_change"
    --bind "enter:become(sx_enter {})"
    --bind "alt-enter:execute-silent(sx_force_open {1})"
    --bind "ctrl-y:execute-silent(sx_clip {1})"
    --bind 'ctrl-w:toggle-preview-wrap'
    --query "$INITIAL_QUERY"
  )

  if [[ "$INITIAL_MODE" != "fd" ]]; then
    fzf_args+=(--disabled)
  fi

  fzf_args+=(--preview-window "down,60%,border-top,wrap")

  fzf "${fzf_args[@]}"
}

main "$@"
